{$SITE_ADDRESS::80} {
    # Proxy Django API requests
    handle /api/* {
        reverse_proxy {$BACKEND_HOST:backend:8000}
    }

    # Proxy Health check
    handle /healthz* {
        reverse_proxy {$BACKEND_HOST:backend:8000}
    }

    # Serve collected static files
    handle /static/* {
        root * /app/staticfiles
        file_server
    }

    # Serve built React Single Page Application
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
